# ==========================================================
# ISLM (Intelligent Service Level Management) Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==========================================================

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./islm.db

# Ollama / SLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# File Storage Configuration
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt,.csv,.xlsx,.png,.jpg,.jpeg,.log,.json,.xml
